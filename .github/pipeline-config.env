# Arquivo de configuração para GitHub Actions
# Este arquivo deve ser usado como referência para configurar
# as variáveis de ambiente e secrets necessários

# ===========================================
# SECRETS OBRIGATÓRIOS NO GITHUB
# ===========================================

# Container Registry (automático)
GITHUB_TOKEN=<automático>

# Kubernetes - Desenvolvimento
KUBECONFIG_DEV=<base64_encoded_kubeconfig_development>
POSTGRES_USER=workshop_user
POSTGRES_PASSWORD=<senha_segura_dev>
POSTGRES_DB=workshop_db

# Kubernetes - Produção  
KUBECONFIG_PROD=<base64_encoded_kubeconfig_production>
POSTGRES_USER_PROD=workshop_user_prod
POSTGRES_PASSWORD_PROD=<senha_muito_segura_prod>
POSTGRES_DB_PROD=workshop_db_prod

# ===========================================
# CONFIGURAÇÃO DOS ENVIRONMENTS
# ===========================================

# Environment: development
# - Deploy automático
# - Sem aprovação necessária
# - Variáveis:
#   - POSTGRES_USER
#   - POSTGRES_PASSWORD  
#   - POSTGRES_DB
#   - KUBECONFIG_DEV

# Environment: production
# - Requer aprovação manual
# - Proteção de branch (main only)
# - Variáveis:
#   - POSTGRES_USER_PROD
#   - POSTGRES_PASSWORD_PROD
#   - POSTGRES_DB_PROD
#   - KUBECONFIG_PROD

# ===========================================
# COMO CONFIGURAR OS KUBECONFIG
# ===========================================

# 1. Obter arquivo kubeconfig do seu cluster:
#    kubectl config view --raw --minify > kubeconfig-dev.yaml

# 2. Codificar em base64:
#    cat kubeconfig-dev.yaml | base64 -w 0

# 3. Adicionar como secret no GitHub:
#    - Vá para Settings > Secrets and variables > Actions
#    - Clique em "New repository secret"
#    - Nome: KUBECONFIG_DEV (ou KUBECONFIG_PROD)
#    - Valor: <output_do_base64>

# ===========================================
# ESTRUTURA DE BRANCHES
# ===========================================

# main -> Produção (requer aprovação)
# develop -> Desenvolvimento (automático)
# fase-2 -> Desenvolvimento (automático)
# hotfix/* -> Hotfix deploy (automático)
# feature/* -> Apenas testes (sem deploy)

# ===========================================
# COMANDOS ÚTEIS PARA SETUP
# ===========================================

# Criar namespace no Kubernetes:
# kubectl create namespace workshop-app

# Aplicar secrets no cluster:
# kubectl create secret generic app-secrets \
#   --from-literal=postgres-user=workshop_user \
#   --from-literal=postgres-password=sua_senha \
#   --from-literal=postgres-db=workshop_db \
#   -n workshop-app

# Verificar deployment:
# kubectl get pods -n workshop-app
# kubectl logs -f deployment/workshop-app-deployment -n workshop-app

# ===========================================
# VERIFICAÇÃO LOCAL
# ===========================================

# Execute antes de fazer push:
# ./scripts/verify-pipeline.sh

# Opções disponíveis:
# ./scripts/verify-pipeline.sh --skip-docker  # Pula testes Docker
# ./scripts/verify-pipeline.sh --skip-k8s     # Pula validação K8s
# ./scripts/verify-pipeline.sh --help         # Mostra ajuda