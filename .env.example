# Configuração de Ambiente Local para Desenvolvimento
# Copie este arquivo para .env e ajuste os valores conforme necessário

# ===========================================
# CONFIGURAÇÕES DA APLICAÇÃO
# ===========================================

# Porta da aplicação
PORT=3000

# Ambiente (development, production, test)
NODE_ENV=development

# ===========================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ===========================================

# URL completa de conexão com PostgreSQL
DATABASE_URL=postgresql://workshop_user:workshop_pass@localhost:5432/workshop_db

# ===========================================
# CONFIGURAÇÕES DE SEGURANÇA
# ===========================================

# Chave secreta para JWT (gere uma chave forte para produção)
JWT_SECRET=mysecret

# Tempo de expiração do JWT (em segundos)
JWT_EXPIRES=300

# Salt rounds para bcrypt
BCRYPT_ROUNDS=10

# ===========================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# ===========================================

# Nível de log (error, warn, info, debug)
LOG_LEVEL=debug

# Habilitar logs detalhados do SQL
DEBUG_SQL=false

# ===========================================
# CONFIGURAÇÕES PARA TESTES
# ===========================================

# Banco de dados para testes
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5433/test_db

# ===========================================
# COMANDOS ÚTEIS
# ===========================================

# Iniciar banco local com Docker:
# docker run -d --name postgres-local \
#   -e POSTGRES_USER=workshop_user \
#   -e POSTGRES_PASSWORD=workshop_pass \
#   -e POSTGRES_DB=workshop_db \
#   -p 5432:5432 \
#   postgres:15

# Executar migrações:
# npm run migrate

# Iniciar aplicação:
# npm start

# Executar pipeline local:
# ./scripts/verify-pipeline.sh